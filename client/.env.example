# Dev-only: where Vite proxies /api requests.
# Only used by `vite dev` and `vite preview` (see vite.config.js).
# Ignored in production builds (`vite build`) — use VITE_API_BASE_URL instead.
API_PROXY_TARGET=http://localhost:3000

# Baked into the production bundle at build time.
# MUST be your backend's REAL public origin — not the placeholder below —
# otherwise every production request goes to a domain that isn't yours
# (and dies with a CORS/network error). Example:
#   VITE_API_BASE_URL=https://your-backend-host.example.com
# Note: the built files in client/dist/ bake this in, so you must rebuild
# (npm run build) after changing it.
VITE_API_BASE_URL=