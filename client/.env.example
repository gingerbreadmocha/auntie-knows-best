# Dev-only: where Vite proxies /api requests.
# Only used by `vite dev` and `vite preview` (see vite.config.js).
# Ignored in production builds (`vite build`) — use VITE_API_BASE_URL instead.
API_PROXY_TARGET=http://localhost:3000

# Baked into the production bundle at build time.
# Point this at your backend's public origin when the frontend is hosted
# separately from the API (e.g. https://api.example.com).
# Leave unset in dev so /api goes through the Vite proxy above.
VITE_API_BASE_URL=