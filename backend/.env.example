# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your-api-key-here

# Port the API server listens on (optional, defaults to 3000)
PORT=3000

# Comma-separated list of origins allowed to call this API from a browser (CORS).
# Production frontends live on a different origin than the backend, so the API
# must send Access-Control-Allow-* headers or browsers will block requests.
# "*" allows any origin (fine for this public, cookie-less API).
# Example: CORS_ORIGIN=https://your-frontend-host.example.com,https://staging.example.com
# CORS_ORIGIN=*